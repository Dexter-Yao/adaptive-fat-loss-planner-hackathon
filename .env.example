# Local development only: uses your existing Codex CLI sign-in.
AGENT_PROVIDER=codex
CODEX_MODEL=gpt-6-luna
CODEX_REASONING_EFFORT=medium

# Public deployments must use server-side Nebius; never expose a local Codex account.
# AGENT_PROVIDER=nebius
# NEBIUS_API_KEY=
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# NEBIUS_MODEL=nvidia/Nemotron-3.5-Super-VL

# Hosted reviewer access requires the server gate and verified platform or durable standalone admission.
PUBLIC_DEMO_ENABLED=false

# Optional per-stage overrides. Unset fields preserve NEBIUS_MODEL/provider defaults.
# Current reviewed stage values live only in config/nemotron-candidate.env.example.
# Use pnpm dev:candidate for that explicit local NVIDIA route; this file does not select it.
# Each prefix also accepts _THINKING=auto|on|off and _MAX_TOKENS=512..16384.

# Server-only tracing. Browser requests export metadata, never health facts or notes.
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_PROJECT=adaptive-fat-loss-planner
# LANGSMITH_WORKSPACE_ID=
# Raw fictional content requires a trusted offline EvalIdentity; no browser flag enables it.

# Hosted container only. Generate private values; never put them in source or a browser bundle.
ADAPTIVE_REVIEW_ACCESS=false
# ADAPTIVE_REVIEW_CODE=
# ADAPTIVE_SESSION_SECRET=
# ADAPTIVE_USAGE_DIR=/var/lib/adaptive
# Vercel only: operator reads back active route-specific WAF rules before setting these.
# ADAPTIVE_RATE_LIMIT_MODE=vercel_waf
# ADAPTIVE_WAF_CONFIG_VERSION=
