# Explicit E workstream candidate: matched fictional J03 only; no quality/clinical certification.
# Load AFTER .env.local only for a bounded Eval or a main-coordinated private preview.
# Does not rewrite private defaults, enable public inference or restart the existing preview.
# Single-tool NVIDIA stages allow one response plus one repair; no hidden model fallback.
NEBIUS_INTERPRET_MODEL=nvidia/Nemotron-3_5-Lightning
NEBIUS_INTERPRET_THINKING=off
NEBIUS_INTERPRET_MAX_TOKENS=2048
NEBIUS_GENERATE_MODEL=nvidia/Nemotron-3.5-Super-VL
NEBIUS_GENERATE_THINKING=on
NEBIUS_GENERATE_MAX_TOKENS=16384
NEBIUS_REVISE_MODEL=nvidia/Nemotron-3.5-Super-VL
NEBIUS_REVISE_THINKING=on
NEBIUS_REVISE_MAX_TOKENS=16384
NEBIUS_REVIEW_PROGRESS_MODEL=nvidia/Nemotron-3.5-Super-VL
NEBIUS_REVIEW_PROGRESS_THINKING=off
NEBIUS_REVIEW_PROGRESS_MAX_TOKENS=4096
# Offline four-dimension Judge remains explicit Ultra, thinking on, max_tokens 8192.
# It is never a default stage or a provider fallback. See docs/agent-evaluation.md.
