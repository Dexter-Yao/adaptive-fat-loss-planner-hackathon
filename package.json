{
  "name": "adaptive-fat-loss-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm design:tokens && next dev --hostname 127.0.0.1 --port 3221",
    "dev:candidate": "pnpm design:tokens && node scripts/preview-candidate.mjs",
    "build": "pnpm design:tokens && next build",
    "start": "next start --hostname 127.0.0.1 --port 3221",
    "typecheck": "pnpm design:check && next typegen && tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:live": "node --import tsx scripts/eval-journey-workflow.ts --cases=smoke",
    "design:tokens": "node scripts/export-design-tokens.mjs",
    "design:check": "node scripts/export-design-tokens.mjs --check"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "langsmith": "0.11.4",
    "lucide-react": "^1.63.0",
    "next": "16.4.3",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.1",
    "recharts": "3.8.0",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "3.6.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "yaml": "2.8.2"
  },
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": "22.x"
  }
}
